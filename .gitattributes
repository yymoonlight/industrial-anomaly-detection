# 默认让 Git 自动识别文本文件
* text=auto

# 需在 Linux 服务器运行的脚本 / 配置，强制使用 LF 行尾
# （避免 Windows 上编写的 .sh 经 FileZilla 传到 AutoDL 后出现 bash 的 \r 报错）
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows 本机脚本保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件，不做行尾与编码转换
*.tar.xz binary
*.tar.gz binary
*.zip    binary
*.pth    binary
*.pt     binary
*.ckpt   binary
*.pkl    binary
*.faiss  binary
*.onnx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
